# TOML。パスはこのファイルのあるフォルダ基準。
simulation = true
temperature_c = -5.0
temperature_tolerance_c = 1.0
cooling_timeout_sec = 900.0
exposure_sec = 1.0
exposure_timeout_sec = 60.0
settle_sec = 1.0
# スリット検出用の参照画像（実ファイルの拡張子は .fits）
flat_path = 'pictures/02_slit_guide_images/test_00.fits'
# オフラインpixelズレ検証の点源画像
pixel_test_image_path = 'pictures/02_slit_guide_images/test_sigmagem_nearby_slit.fit'
# science: 上記1枚からスリットと点源を検出。reference: flat_pathでスリット検出。
pixel_test_slit_mode = 'science'
pixel_test_slit_roi = [880, 250, 1130, 850]
# 自動追尾も毎フレームの星像画像からスリットを検出する。
guide_slit_mode = 'science'
guide_slit_roi = [880, 250, 1130, 850]
output_path = 'pictures/02_slit_guide_images/slit_guide_image_loop.fit'
slit_roi = [450, 250, 660, 760] # test_00.fitsのスリット領域。x0,y0,x1,y1
target_brightness_rank = 1
threshold_sigma = 5.0
max_target_jump_px = 15.0
deadband_px = 0.5
# [RA,Dec]補正量 = matrix × [slit_x-star_x, slit_y-star_y]
# 単位・符号は実機校正と送信アダプターで確定すること。
matrix = [[1.0, 0.0], [0.0, 1.0]]
gain = 0.5
max_correction = 10.0
adaptive_rate = 0.05
# 実機では校正後に true に変更
calibration_confirmed = false
# 提供された送信コードと同じTCP/JSON形式。単位はMoT側の定義に合わせる。
mot_host = '10.91.80.225'
mot_port = 8744
mot_timeout_sec = 5.0
# 成功応答が確定したら全文を設定。空文字は非空応答の受信のみを確認。
mot_expected_response = ''
