# TOML。パスはこのファイルのあるフォルダ基準。
# false: 実カメラに接続。赤道儀への送信は mot_enabled で別途指定。
simulation = false
# 未校正の間は撮像・解析のみ。校正後に true にする。
mot_enabled = true
temperature_c = 0.0
temperature_tolerance_c = 1.0
cooling_timeout_sec = 900.0
exposure_sec = 0.5
exposure_timeout_sec = 60.0
settle_sec = 1.0
# スリット検出用の参照画像（実ファイルの拡張子は .fits）
flat_path = 'pictures/02_slit_guide_images/test_00.fits'
# オフラインpixelズレ検証の点源画像
pixel_test_image_path = 'pictures/02_slit_guide_images/test_sigmagem_nearby_slit.fit'
# science: 上記1枚からスリットと点源を検出。reference: flat_pathでスリット検出。
pixel_test_slit_mode = 'science'
pixel_test_slit_roi = [880, 250, 1130, 850]
# 自動追尾も毎フレームの星像画像からスリットを検出する。
guide_slit_mode = 'science'
guide_slit_roi = [880, 250, 1130, 850]
# スリット校正の探索中心の目安（左から3/5、上から3/7）。位置固定値ではない。
slit_center_hint_fraction = [0.6, 0.42857142857142855]
# 照明ONの校正画像（2026-09-24）から測定した両端の中点。座標は0始まり。
slit_initial_center_px = [544.82841769, 479.05785906]
slit_initial_image_shape = [1039, 1391]
output_path = 'pictures/02_slit_guide_images/slit_guide_image_loop.fit'
slit_roi = [450, 250, 660, 760] # test_00.fitsのスリット領域。x0,y0,x1,y1
target_brightness_rank = 1
threshold_sigma = 5.0
max_target_jump_px = 15.0
matrix_min_samples = 5
matrix_step_scale = 0.35
deadband_px = 0.5
# MoT guideのRA/Dec補正量は秒角。初期値は1秒角/pixel。
# max_correction=0 は上限なし（free）。
matrix = [[1.0, 0.0], [0.0, 1.0]]
# RA/Dec方向の補正ゲイン（0〜1）。1 pixelあたり初期1秒角。
gain_ra = 1.0
gain_dec = 1.0
# true: 補正後にズレが増えた場合、gainの符号を自動反転する。
auto_gain_enabled = true
# 旧設定との互換用。新規設定では gain_ra/gain_dec を使用する。
gain = 1.0
# 1回の補正上限（秒角）。初期gain変更後の安全上限。
max_correction = 100.0
max_gain_abs = 10.0
pixel_scale_arcsec = 2.0
azimuth_deg = 0.0
declination_deg = 0.0
adaptive_rate = 0.05
# 実機では校正後に true に変更
calibration_confirmed = true
# 提供された送信コードと同じTCP/JSON形式。単位はMoT側の定義に合わせる。
mot_host = '10.91.80.225'
mot_port = 8744
mot_timeout_sec = 5.0
# 成功応答が確定したら全文を設定。空文字は非空応答の受信のみを確認。
mot_expected_response = ''
